{
  "expo": {
    "name": "経費精算",
    "slug": "expense-mobile",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "scheme": "expense",
    "ios": { "supportsTablet": true },
    "android": { "package": "com.example.expense" },
    "web": { "bundler": "metro" },
    "plugins": [
      "expo-router",
      ["expo-image-picker", { "cameraPermission": "レシートを撮影して金額・日付を自動入力するためにカメラを使用します。" }]
    ],
    "extra": {
      "apiUrl": "http://localhost:8080"
    }
  }
}
