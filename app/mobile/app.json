{
  "expo": {
    "name": "RingiWoMerge",
    "slug": "expense-mobile",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "scheme": "expense",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.example.expense",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#f6f8fa"
      }
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "cameraPermission": "Take photos of receipts and product documents to attach them to purchase requests.",
          "photosPermission": "Attach photos of receipts and product documents to purchase requests."
        }
      ],
      "expo-web-browser"
    ],
    "extra": {
      "apiUrl": "http://localhost:8080"
    },
    "icon": "./assets/icon.png"
  }
}
