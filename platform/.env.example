POSTGRES_USER=expense
POSTGRES_PASSWORD=expense
POSTGRES_DB=expense

JWT_SECRET=change-me-to-a-long-random-string

# API_URL is used by the Next.js server to reach the backend container.
# In Docker compose this should be the inter-container DNS name.
API_URL=http://backend:8080

RUST_LOG=info,sqlx=warn

# Web Push (optional). If VAPID_PRIVATE_KEY is empty, the API generates a key on first start
# and keeps it in the database. Set VAPID_SUBJECT to the operator's contact (mailto: or https:).
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:admin@example.com
