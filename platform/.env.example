POSTGRES_USER=expense
POSTGRES_PASSWORD=expense
POSTGRES_DB=expense

JWT_SECRET=change-me-to-a-long-random-string

# API_URL is used by the Next.js server to reach the backend container.
# In Docker compose this should be the inter-container DNS name.
API_URL=http://backend:8080

RUST_LOG=info,sqlx=warn

# Web Push (optional). If VAPID_PRIVATE_KEY is empty, the API generates a key on first start
# and keeps it in the database. Set VAPID_SUBJECT to the operator's contact (mailto: or https:).
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:admin@example.com

# SSO (OpenID Connect, optional). Leave OIDC_ISSUER / OIDC_CLIENT_ID / OIDC_CLIENT_SECRET empty to disable it.
# Register a confidential client at your identity provider (authorization code + PKCE S256) with this redirect URI:
#   {PUBLIC_BASE_URL}/api/auth/sso/callback
# Only users who log in with their password and link SSO in Settings can use it (no sign-up).
# OIDC_ISSUER=https://auth.example.com/auth/v1
# OIDC_CLIENT_ID=expense
# OIDC_CLIENT_SECRET=
# Require the ID token's amr to contain "mfa" (e.g. passkey login). Default: true
# OIDC_REQUIRE_MFA=true
# OIDC_DISPLAY_NAME=SSO
# PUBLIC_BASE_URL=http://localhost:3100
# OIDC_MOBILE_REDIRECT_PREFIXES=expense://,exp://
# OIDC_LINK_DENY_EMAIL_DOMAINS=example.com
# Emergency switch: let users who chose "SSO only" log in with their password again (e.g. while the IdP is down)
# OIDC_ALLOW_PASSWORD_FOR_SSO_ONLY=false
